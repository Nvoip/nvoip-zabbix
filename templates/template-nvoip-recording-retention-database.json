{
  "zabbix_export": {
    "version": "7.0",
    "template_groups": [
      {
        "uuid": "7005ce3778b443e3a304a17ae049b3c6",
        "name": "Templates/Databases"
      }
    ],
    "templates": [
      {
        "uuid": "6004cbe3cb424c2e8dff5fba198f1ae2",
        "template": "Template Nvoip Recording Retention Database",
        "name": "Template Nvoip Recording Retention Database",
        "description": "NN-2350/NN-4830: aggregate, read-only health checks for exact-version deletion and warning delivery. No customer identifier, address, message body, object key or version is collected.",
        "groups": [
          {
            "name": "Templates/Databases"
          }
        ],
        "items": [
          {
            "uuid": "2e12b3c5ab6044eb805b5f5fa00e904e",
            "name": "Recording retention: health counters (JSON)",
            "type": "ODBC",
            "key": "db.odbc.get[nvoip.recording.retention.health,{$NVOIP.RETENTION.DB.DSN}]",
            "delay": "2m",
            "history": "1d",
            "value_type": "TEXT",
            "trends": "0",
            "params": "SELECT approval_active,approval_seconds_left,pending_intent_count,oldest_pending_seconds,deleted_5m,audited_deleted_5m,due_candidate_count,active_legal_hold_count,deleted_without_gone_count,gone_without_deleted_count,warning_pending_over_30m,warning_failed_1h FROM nn2350_monitor_recording_retention_health",
            "tags": [
              { "tag": "jira", "value": "NN-2350" },
              { "tag": "jira", "value": "NN-4830" },
              { "tag": "service", "value": "recording-retention" }
            ],
            "triggers": [
              {
                "uuid": "519af0fa94044c6ca1968d16e7480e66",
                "expression": "nodata(/Template Nvoip Recording Retention Database/db.odbc.get[nvoip.recording.retention.health,{$NVOIP.RETENTION.DB.DSN}],5m)=1",
                "name": "Recording retention database monitor has no fresh sample",
                "priority": "HIGH",
                "description": "The aggregate read-only collector stopped. Validate the ODBC poller and database connectivity before treating deletion or warning health as known.",
                "tags": [{ "tag": "jira", "value": "NN-4830" }]
              }
            ]
          },
          {
            "uuid": "ee6830a363014951a8ab8376fa2f68df",
            "name": "Recording retention: operational approval active",
            "type": "DEPENDENT",
            "key": "nvoip.recording.retention.approval.active",
            "delay": "0",
            "history": "90d",
            "trends": "365d",
            "preprocessing": [{ "type": "JSONPATH", "parameters": ["$[0].approval_active"] }],
            "master_item": { "key": "db.odbc.get[nvoip.recording.retention.health,{$NVOIP.RETENTION.DB.DSN}]" },
            "triggers": [
              {
                "uuid": "57bb95ab31c24071837c9e4fcfa446cf",
                "expression": "max(/Template Nvoip Recording Retention Database/nvoip.recording.retention.approval.active,5m)=0",
                "name": "Recording retention operational approval is absent or expired",
                "priority": "HIGH",
                "description": "Exact-version deletion is expected to fail closed. Review the approval window; do not create or extend an approval automatically.",
                "tags": [{ "tag": "jira", "value": "NN-4830" }]
              }
            ]
          },
          {
            "uuid": "70b40dbae8bd41ad8aa761a6d94f61e7",
            "name": "Recording retention: approval seconds left",
            "type": "DEPENDENT",
            "key": "nvoip.recording.retention.approval.seconds_left",
            "delay": "0",
            "history": "90d",
            "trends": "365d",
            "units": "s",
            "preprocessing": [{ "type": "JSONPATH", "parameters": ["$[0].approval_seconds_left"] }],
            "master_item": { "key": "db.odbc.get[nvoip.recording.retention.health,{$NVOIP.RETENTION.DB.DSN}]" },
            "triggers": [
              {
                "uuid": "fc771abf0a6341e6887bfe6a244458e4",
                "expression": "max(/Template Nvoip Recording Retention Database/nvoip.recording.retention.approval.seconds_left,5m)>=0 and max(/Template Nvoip Recording Retention Database/nvoip.recording.retention.approval.seconds_left,5m)<{$NVOIP.RETENTION.APPROVAL.WARN}",
                "name": "Recording retention approval expires in less than {$NVOIP.RETENTION.APPROVAL.WARN} seconds",
                "priority": "WARNING",
                "description": "A human decision will be required before the approval expires. This trigger never renews approval.",
                "tags": [{ "tag": "jira", "value": "NN-4830" }]
              }
            ]
          },
          {
            "uuid": "55fc094d6da945c0937771514d933d1c",
