            "delay": "0",
            "history": "90d",
            "trends": "365d",
            "units": "s",
            "preprocessing": [{ "type": "JSONPATH", "parameters": ["$[0].oldest_pending_seconds"] }],
            "master_item": { "key": "db.odbc.get[nvoip.recording.retention.health,{$NVOIP.RETENTION.DB.DSN}]" },
            "triggers": [
              {
                "uuid": "a6b61b50f5ba41119a73dcec59c5e869",
                "expression": "min(/Template Nvoip Recording Retention Database/nvoip.recording.retention.intent.pending,5m)>0 and min(/Template Nvoip Recording Retention Database/nvoip.recording.retention.intent.oldest_seconds,5m)>{$NVOIP.RETENTION.INTENT.MAX_AGE}",
                "name": "Recording retention has a stuck or uncertain delete intent",
                "priority": "DISASTER",
                "description": "Stop and reconcile the durable intent, database ledger and exact S3 version. Never retry by deleting a key without its recorded version ID.",
                "manual_close": "YES",
                "tags": [{ "tag": "jira", "value": "NN-4830" }]
              }
            ]
          },
          {
            "uuid": "aabe190594bc420daf8d85235d148412",
