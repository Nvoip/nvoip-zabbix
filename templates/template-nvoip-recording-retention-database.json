            "type": "DEPENDENT",
            "key": "nvoip.recording.retention.deleted.5m",
            "delay": "0",
            "history": "90d",
            "trends": "365d",
            "preprocessing": [{ "type": "JSONPATH", "parameters": ["$[0].deleted_5m"] }],
            "master_item": { "key": "db.odbc.get[nvoip.recording.retention.health,{$NVOIP.RETENTION.DB.DSN}]" },
            "triggers": [
              {
                "uuid": "6bfd7a0aff7a44f09567243908379088",
                "expression": "max(/Template Nvoip Recording Retention Database/nvoip.recording.retention.deleted.5m,5m)>{$NVOIP.RETENTION.DELETE.MAX_5M}",
                "name": "Recording retention deletion rate exceeded the batch-1 envelope",
                "priority": "DISASTER",
                "description": "The approved runtime is batch 1 per scheduler cycle. Inactivate approval and reconcile before any further deletion; this trigger performs no automatic rollback.",
                "manual_close": "YES",
                "tags": [{ "tag": "jira", "value": "NN-4830" }]
              }
            ]
          },
