            "type": "DEPENDENT",
            "key": "nvoip.recording.retention.intent.pending",
            "delay": "0",
            "history": "90d",
            "trends": "365d",
            "preprocessing": [{ "type": "JSONPATH", "parameters": ["$[0].pending_intent_count"] }],
            "master_item": { "key": "db.odbc.get[nvoip.recording.retention.health,{$NVOIP.RETENTION.DB.DSN}]" }
          },
          {
            "uuid": "6c47f677b16f498aac803d60e43389ce",
            "name": "Recording retention: oldest pending intent",
