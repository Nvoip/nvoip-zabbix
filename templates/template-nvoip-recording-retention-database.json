            "history": "90d",
            "trends": "365d",
            "preprocessing": [{ "type": "JSONPATH", "parameters": ["$[0].deleted_without_gone_count"] }],
            "master_item": { "key": "db.odbc.get[nvoip.recording.retention.health,{$NVOIP.RETENTION.DB.DSN}]" },
            "triggers": [
              {
                "uuid": "2de8cfaa69c6430d923466a709ec8537",
