        "template": "Template Nvoip API JVM Memory",
        "name": "Template Nvoip API JVM Memory",
        "description": "NN-6146: monitors memory headroom, swap and the Tomcat 9/10 JVMs on the Nvoip API host without collecting application or customer data.",
        "groups": [
          {
            "name": "Templates/Applications"
          }
        ],
        "items": [
          {
            "uuid": "fbc9d41c66f44220a1749e7fd0cd6b17",
            "name": "API memory collector: sample (JSON)",
            "type": "ZABBIX_ACTIVE",
            "key": "vfs.file.contents[/run/nvoip-api-memory/metrics.json]",
            "delay": "1m",
            "history": "1d",
            "value_type": "TEXT",
            "trends": "0",
            "tags": [
              {
                "tag": "component",
                "value": "api-memory"
              },
              {
                "tag": "jira",
                "value": "NN-6146"
              }
            ]
          },
          {
            "uuid": "0bb62f205e1f437c8f30a492cd5398af",
            "name": "API memory collector: sample timestamp",
            "type": "DEPENDENT",
            "key": "nvoip.api.memory.sample.epoch",
            "delay": "0",
            "history": "30d",
            "trends": "365d",
            "units": "unixtime",
            "preprocessing": [
              {
                "type": "JSONPATH",
                "parameters": [
                  "$.collected_at_epoch"
                ]
              }
            ],
            "master_item": {
              "key": "vfs.file.contents[/run/nvoip-api-memory/metrics.json]"
            },
            "triggers": [
              {
                "uuid": "dd5f0cd5747d4a5f91a064eb2ca32f33",
                "expression": "fuzzytime(/Template Nvoip API JVM Memory/nvoip.api.memory.sample.epoch,180s)=0",
                "name": "API memory collector has no fresh sample for 3 minutes",
                "priority": "HIGH",
                "description": "The NN-6146 collector stopped producing fresh data. Validate the systemd timer, both Tomcat processes and jstat before treating memory health as known.",
                "manual_close": "YES",
                "tags": [
                  {
                    "tag": "jira",
                    "value": "NN-6146"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "44c45513fc894f7f8d32037f49fb4fa2",
            "name": "API host: available memory",
            "type": "DEPENDENT",
            "key": "nvoip.api.host.memory.available",
            "delay": "0",
            "history": "30d",
            "trends": "365d",
            "units": "B",
            "preprocessing": [
              {
                "type": "JSONPATH",
                "parameters": [
                  "$.host.memory_available_bytes"
                ]
              }
            ],
            "master_item": {
              "key": "vfs.file.contents[/run/nvoip-api-memory/metrics.json]"
            },
            "triggers": [
              {
                "uuid": "b491c53af7ea4fc8b0fe12b78cf1251d",
                "expression": "max(/Template Nvoip API JVM Memory/nvoip.api.host.memory.available,10m)<{$NVOIP.API.MEM.AVAILABLE.WARN} and min(/Template Nvoip API JVM Memory/nvoip.api.host.memory.available,10m)>={$NVOIP.API.MEM.AVAILABLE.HIGH}",
                "name": "API host has less than {$NVOIP.API.MEM.AVAILABLE.WARN} bytes available for 10 minutes",
                "priority": "WARNING",
                "description": "Available memory is below the early-warning threshold. The deploy guard refuses publication at 600 MiB, so investigate JVM growth and concurrent deployments before the host reaches that boundary.",
                "manual_close": "YES",
                "tags": [
                  {
                    "tag": "jira",
                    "value": "NN-6146"
                  }
                ]
              },
              {
                "uuid": "59ae2d63ce504a1c897ee2acf373393b",
                "expression": "max(/Template Nvoip API JVM Memory/nvoip.api.host.memory.available,5m)<{$NVOIP.API.MEM.AVAILABLE.HIGH}",
                "name": "API host is near the 600 MiB deploy guard",
                "priority": "HIGH",
                "description": "Available memory remained below the high threshold. Stop new deployments to this host and inspect Tomcat memory before availability is affected; this trigger does not restart a service or force a GC.",
                "manual_close": "YES",
                "tags": [
                  {
                    "tag": "jira",
                    "value": "NN-6146"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "e06c8cb614ad4ca58529cefaea6438d6",
            "name": "API host: used swap",
            "type": "DEPENDENT",
            "key": "nvoip.api.host.swap.used",
            "delay": "0",
            "history": "30d",
            "trends": "365d",
            "units": "B",
            "preprocessing": [
              {
                "type": "JSONPATH",
                "parameters": [
                  "$.host.swap_used_bytes"
                ]
              }
            ],
            "master_item": {
              "key": "vfs.file.contents[/run/nvoip-api-memory/metrics.json]"
            },
            "triggers": [
              {
                "uuid": "371082680a7e4cec8321deecbca33124",
                "expression": "min(/Template Nvoip API JVM Memory/nvoip.api.host.swap.used,15m)>{$NVOIP.API.SWAP.USED.WARN} and max(/Template Nvoip API JVM Memory/nvoip.api.host.swap.used,15m)<={$NVOIP.API.SWAP.USED.HIGH}",
                "name": "API host is sustaining more than {$NVOIP.API.SWAP.USED.WARN} bytes of swap",
                "priority": "WARNING",
                "description": "The host is relying on swap long enough to threaten Full GC latency. Investigate memory headroom; do not clear swap or restart a Tomcat automatically.",
                "manual_close": "YES",
                "tags": [
                  {
                    "tag": "jira",
                    "value": "NN-6146"
                  }
                ]
              },
              {
                "uuid": "a6ee16f4fdfc4b8a8c49b6cda8f52150",
                "expression": "min(/Template Nvoip API JVM Memory/nvoip.api.host.swap.used,10m)>{$NVOIP.API.SWAP.USED.HIGH}",
                "name": "API host is sustaining more than {$NVOIP.API.SWAP.USED.HIGH} bytes of swap",
                "priority": "HIGH",
                "description": "Swap use crossed the high threshold observed near long Full GC pauses. Treat this as a capacity incident and inspect both JVMs before changing the runtime.",
                "manual_close": "YES",
                "tags": [
                  {
                    "tag": "jira",
                    "value": "NN-6146"
                  }
                ]
              }
            ]
          },
