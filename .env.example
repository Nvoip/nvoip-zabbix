NVOIP_BASE_URL=https://api.nvoip.com.br/v3
NVOIP_AUTH_URL=https://api.nvoip.com.br/auth/oauth2/token
NVOIP_AUTH_MODE=client_credentials
NVOIP_OAUTH_CLIENT_ID=
NVOIP_OAUTH_CLIENT_SECRET=
# Optional bearer mode requires an externally renewed token.
# NVOIP_AUTH_MODE=bearer
# NVOIP_ACCESS_TOKEN=
NVOIP_CALLER=
NVOIP_SMS_MAX_CHARS=160
NVOIP_VOICE_MAX_CHARS=600
NVOIP_HTTP_TIMEOUT=10
